  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sample_index,status,generated_token_rate_tokens_s,output_token_throughput_tokens_sec,time_per_output_token_tpot_ms_token,time_per_output_token_tpot_p50_msec,ttft_ms,ttft_p50_msec,inter_token_latency_itl_ms,inter_token_latency_itl_p50_msec,total_request_completion_time_ms,end_to_end_request_latency_msec,error_message\n0,ok,50,50,18,18,30,30,17,17,400,400,"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --model-name mistralai/Mistral-7B-v0.3 --dtype bfloat16 --tensor-parallel-size 1 --gpu-memory-utilization 0.9 --prompt-source synthetic --input-len 64 --output-len 16 --max-num-seqs 2 --max-concurrency 2"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --model-name mistralai/Mistral-7B-v0.3 --dtype bfloat16 --tensor-parallel-size 1 --gpu-memory-utilization 0.9 --prompt-source synthetic --input-len 512 --output-len 13720 --max-num-seqs 8 --max-concurrency 8"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --model-name mistralai/Mistral-7B-v0.3 --dtype bfloat16 --tensor-parallel-size 1 --gpu-memory-utilization 0.9 --prompt-source synthetic --input-len 1024 --output-len 18600 --max-num-seqs 16 --max-concurrency 8"
  },
  {
    "field_name": "Output Fields / Metrics to Parse",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "generated_token_rate_tokens_s, time_per_output_token_tpot_ms_token, ttft_ms, inter_token_latency_itl_ms, total_request_completion_time_ms. Aliases on the same row: output_token_throughput_tokens_sec, time_per_output_token_tpot_p50_msec, ttft_p50_msec, inter_token_latency_itl_p50_msec, end_to_end_request_latency_msec. These values are p50"
  },
  {
    "field_name": "Success Criteria",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "status=ok and the token rate, TTFT, TPOT, ITL, and end-to-end latency are finite"
  },
  {
    "field_name": "Parser and Normalization Notes",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Same streaming path as workload 128 with this workload's column names. dtype is bfloat16. TPOT = (E2E - TTFT) / (output tokens - 1) from usage.completion_tokens. ITL p50 is over every inter-token gap. end_to_end_request_latency_msec stores the p50. The summary is written twice"
  },
